# mash: words, variables, quoting, carets, generators, pipes and redirection.
d = /mnt/shtest/mash-lang;
rm -rf $d;
mkdir -p $d;

# Lists and the forms of $.
x = a b c;
echo $x;
echo $"x;
echo (len $x) (hd $x) (tl $x);
empty = ;
echo [$empty] (len $empty);
whatis x empty;

# Quoting: a backslash escapes a quote or a backslash.
echo 'it\'s' 'a\\b' 'two words';
quote 'it\'s' plain 'a b' '*';

# Carets: free, explicit, distributive and pairwise.
stem = rotta;
echo $stem.b -$stem;
echo x^$x $x^.c;
echo (a :: b :: c)^(1 :: 2);
n = 1 2;
echo $x^$n;
echo '['^$empty^']';

# Generators.
lines = `{echo one two; echo three};
echo (len $lines) $lines;
first = "{echo first line; echo second};
echo (len $first) $first;
echo 'a b c' > $d/f;
cat <{cat $d/f};
# A >{} generator's name given to a command, which writes on it: the
# "{} that runs it reads until the generator's cat exits.
echo "{mash -c 'echo piped > '^(>{cat})};

# Redirection and pipes.
echo hello > $d/out;
echo again >> $d/out;
cat < $d/out;
cat $d/out | tr a-z A-Z;
echo a b c | tr a-z A-Z | cat;
{ echo grouped; echo output } > $d/g;
cat $d/g;
echo rw > $d/rw;
cat <> $d/rw;
cat $d/rw;

# File name patterns, after all other expansion.
echo -n > $d/p1.c; echo -n > $d/p2.c; echo -n > $d/p.h;
echo $d^/*.c;
echo $d/p?.c;
echo $d/p[2-9].c;
echo $d/nomatch*;
echo '*.c';

# Background commands and sequencing.
# A generator reads until the background command, which holds its
# pipe, is done.
echo "{echo bg &};
rm -r $d;
